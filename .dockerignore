# Kept out of the build context – the files `docker build .` sends to the builder.

# Made by the build itself: the image installs and builds its own, for Linux.
node_modules
dist
.angular

# Not needed to build the app.
.git
.github
.claude
.vscode
.idea
docs
coverage
*.md

# The backend: Dockerfile v1 only builds Angular, and a C# change would rebuild it for nothing.
# Comes out again in M2 D1, when Dockerfile v2 builds the API too.
server
