<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Angular's lists of statuses and streaming services, copied next to the tests for
         Shows/AngularListsTests, which checks that the API allows the same ids. -->
    <None Include="..\..\src\app\shows\show-status.ts" Link="Angular\show-status.ts" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\app\shows\streaming-service.ts" Link="Angular\streaming-service.ts" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.14" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.16.0" />
    <PackageReference Include="xunit.v3.mtp-v2" Version="4.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WatchTracker.Api\WatchTracker.Api.csproj" />
  </ItemGroup>

</Project>
